{
  "schema": "rranker-game-model/v1",
  "gameId": "test",
  "displayName": "测试游戏",
  "assetResolvers": [],
  "tagGroups": [
    {
      "id": "difficulty",
      "role": "difficulty-axis",
      "shape": "pill",
      "valueSeparator": "space",
      "simplifiedInCatalog": true,
      "items": [
        {
          "id": "normal",
          "label": "NORMAL",
          "style": {
            "surface": {
              "background": {
                "kind": "gradient",
                "colors": ["#246BFD", "#75A1FF"],
                "locations": [0, 1],
                "direction": "horizontal",
                "animated": true,
                "durationMs": 1800
              },
              "overlay": {
                "paint": {
                  "kind": "solid",
                  "color": "#000000"
                },
                "opacity": 0.08
              }
            },
            "text": {
              "fill": {
                "kind": "solid",
                "color": "#FFFFFF"
              }
            }
          }
        }
      ]
    },
    {
      "id": "score",
      "role": "attribute",
      "scope": "chart",
      "shape": "none",
      "items": [
        {
          "id": "value",
          "label": "分数",
          "style": {
            "text": {
              "fill": {
                "kind": "solid",
                "color": "#111827"
              }
            }
          }
        }
      ]
    }
  ],
  "pages": {
    "overview": {
      "enabled": true,
      "filters": [],
      "slots": ["account-name", "primary-card", "sync-actions", "toolbox", "library", "source-status"],
      "actions": []
    },
    "best": {
      "enabled": true,
      "filters": [],
      "slots": ["content"],
      "actions": []
    },
    "records": {
      "enabled": true,
      "searchPlaceholder": "搜索歌曲",
      "filters": [
        {
          "id": "score",
          "title": "分数",
          "control": "range",
          "minimum": 0,
          "maximum": 1000000
        }
      ],
      "slots": ["search", "filters", "content"],
      "actions": []
    },
    "catalog": {
      "enabled": true,
      "searchPlaceholder": "搜索歌曲",
      "filters": [],
      "slots": ["search", "content"],
      "actions": []
    },
    "detail": {
      "enabled": true,
      "filters": [],
      "slots": ["content", "local-tags", "custom-sections"],
      "actions": [
        {
          "id": "search-chart",
          "label": "搜索谱面",
          "action": {
            "id": "open-external-search",
            "params": {}
          }
        }
      ]
    }
  }
