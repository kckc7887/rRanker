{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/patch-decode-uri-component.cjs && node scripts/patch-react-native-webview-xiaomi-bridge.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src tests vitest.config.ts jest.config.js",
    "typecheck": "tsc --noEmit && npm run typecheck:maimai-player && npm run typecheck:phigros-player && npm run typecheck:osu-player && npm run typecheck:rizline-player",
    "typecheck:phigros-player": "tsc -p tsconfig.phigros-player.json",
    "check:generated": "node scripts/build-chart-preview.mjs --check && node scripts/build-phigros-chart-preview.mjs --check && node scripts/build-osu-chart-preview.mjs --check && node scripts/build-rizline-chart-preview.mjs --check",
    "typecheck:osu-player": "tsc -p tsconfig.osu-player.json",
    "typecheck:rizline-player": "tsc -p tsconfig.rizline-player.json",
    "typecheck:maimai-player": "tsc -p tsconfig.maimai-player.json",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run",
    "test:ui": "jest --runInBand",
    "test:watch": "vitest",
    "build:chart-preview": "node scripts/build-chart-preview.mjs",
    "build:phigros-chart-preview": "node scripts/build-phigros-chart-preview.mjs",
    "build:osu-chart-preview": "node scripts/build-osu-chart-preview.mjs",
    "build:rizline-chart-preview": "node scripts/build-rizline-chart-preview.mjs",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk:debug": "expo prebuild --platform android && cd android && gradlew.bat assembleDebug",
    "apk:release": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "apk:release:abi": "cd android && gradlew.bat assembleRelease",
    "eas:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "2.4.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.2",
    "crypto-js": "^4.2.0",
    "expo": "~56.0.23",
    "expo-asset": "~56.0.25",
    "expo-blur": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.13",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.18",
    "expo-location": "~56.0.26",
    "expo-media-library": "~56.0.11",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "gcoord": "1.0.7",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "wanakana": "^5.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "29.5.14",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-maps"
        ]
      }
    }
  }
}
