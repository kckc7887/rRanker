{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.3.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/patch-react-native-webview-xiaomi-bridge.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src tests vitest.config.ts jest.config.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run",
    "test:ui": "jest --runInBand",
    "test:watch": "vitest",
    "build:chart-preview": "node scripts/build-chart-preview.mjs",
    "build:phigros-chart-preview": "node scripts/build-phigros-chart-preview.mjs",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk:debug": "expo prebuild --platform android && cd android && gradlew.bat assembleDebug",
    "apk:release": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "apk:release:abi": "cd android && gradlew.bat assembleRelease",
    "eas:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.2",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "ts-pattern": "^5.9.0",
    "wanakana": "^5.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "29.5.14",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
